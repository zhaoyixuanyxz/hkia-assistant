# Copy to repo root as `.env` and fill in values. Never commit real secrets.

# DeepSeek (OpenAI-compatible API) — phase 1 live LLM; leave empty only if using mock below
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# Set true to use built-in mock LLM (no external calls; useful for CI / local without key)
USE_MOCK_LLM=false

# JWT for MVP auth — use a long random string in real environments
JWT_SECRET=change-me-use-a-long-random-secret

# Backend HTTP
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated origins for CORS (browser frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database — SQLite default for quick dev; PostgreSQL recommended for phase 2 full stack
# Example Postgres (adjust user/pass/db): postgresql+psycopg://hkia:hkia@localhost:5432/hkia
DATABASE_URL=sqlite:///./hkia.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Qdrant (vectors). Leave empty to use offline keyword+local embedding fallback only.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embeddings — OpenAI-compatible HTTP API (used for product/memory vectors). If unset, backend uses deterministic mock vectors (fine for CI).
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Profile cadence — refresh structured profile every N user turns (default 4 ≈ between 3–5)
PROFILE_REFRESH_EVERY_N_USER_TURNS=4

# LangSmith — optional tracing for LangGraph / LangChain (requires API key)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hkia

# Force in-memory LangGraph checkpointer even when DATABASE_URL is Postgres (tests / debugging)
FORCE_MEMORY_CHECKPOINTER=false

# Phase 4: admin PATCH /admin/products — API key (scripts) OR Bearer token for users with role=admin
ADMIN_API_KEY=
# Comma-separated emails to promote to admin on each API startup (must already be registered)
ADMIN_BOOTSTRAP_EMAILS=

# Optional: public API base URL for the Next.js app (no secrets here)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
