# 中国大陆 Docker Compose 加速配置（DaoCloud 镜像前缀 + 国内 npm/pip）
# 用法：docker compose --env-file docker.cn.env up -d --build
# 启动：双击 .启动项-境内.bat（或 .启动项.bat 选 1）

POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16
QDRANT_IMAGE=docker.m.daocloud.io/qdrant/qdrant:v1.15.2
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine

# 构建阶段 npm / pip 加速（仅影响镜像 build，不影响本机开发）
NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
